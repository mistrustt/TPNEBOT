# =============================================================================
# TPNEBOT environment template
# Copy to .env and fill in real values. .env is loaded by bot.py via python-dotenv
# AND consumed by docker compose (env_file + variable substitution).
# =============================================================================

# ---- Infisical Secrets Management --------------------------------------------
# The bot fetches runtime secrets from Infisical at startup. Only the
# machine-identity credentials go in this file. The actual secrets
# (TOKEN, DB_PW, USER_ID_HASH_KEY, etc.) live in Infisical.
# If INFISICAL_CLIENT_ID is not set, the bot falls back to reading all
# secrets directly from environment variables as before.
INFISICAL_CLIENT_ID=your-machine-identity-client-id
INFISICAL_CLIENT_SECRET=your-machine-identity-client-secret
INFISICAL_SITE_URL=https://us.infisical.com
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENVIRONMENT=prod

# ---- Required: Discord --------------------------------------------------------
# Used only when Infisical is not configured. Otherwise loaded from Infisical.
TOKEN=replace-me-with-discord-bot-token
DEVELOPER_CHANNEL_ID=0

# ---- Database ----------------------------------------------------------------
# Used directly by bot.py via DB_HOST/DB_PORT/DB_USER/DB_NAME/DB_PW.
# docker-compose.yml wires these into the `app` service so it can reach the
# `db` service. For bare-metal runs, point them at a real Postgres.
# DB_PW is used only when Infisical is not configured.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_PW=change-me

# ---- Security ----------------------------------------------------------------
# USER_ID_HASH_KEY is the HMAC-SHA256 key used to hash Discord user IDs before
# storing them in the database. It must match the key used when running the
# secure_user_ids.sql migration. If not set, the bot falls back to STATS_SALT.
# Used only when Infisical is not configured.
# Generate with: openssl rand -hex 32
USER_ID_HASH_KEY=change-me-to-a-long-random-secret

# STATS_SALT is still used for the existing analytics hash in command_usage_daily
# and daily_user_exposure. It can be the same value as USER_ID_HASH_KEY, but
# USER_ID_HASH_KEY is preferred for operational tables.
# Used only when Infisical is not configured.
STATS_SALT=change-me

# ---- Admin API (aiohttp, in-process) -----------------------------------------
# ADMIN_API_HOST is set inside the container to 0.0.0.0 by docker-compose so
# the port mapping can reach it. ADMIN_API_ALLOW_EXTERNAL_BIND=1 is the
# explicit opt-in AdminAPIServer.start() checks before binding non-loopback.
# ADMIN_API_SECRET is used only when Infisical is not configured.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8080
ADMIN_API_SECRET=change-me
ADMIN_API_ALLOW_EXTERNAL_BIND=0
