# =============================================================================
# TPNEBOT environment variables (envy proof) 
# Copy to .env and fill in real values. .env is loaded by bot.py via python-dotenv
# AND consumed by docker compose (env_file + variable substitution).
#
# IMPORTANT: All secrets (API keys, tokens, encryption keys, passwords) live in
# Infisical. This file must ONLY contain non-sensitive configuration and the
# Infisical machine-identity credentials needed to fetch those secrets.
# =============================================================================

# ---- Infisical Secrets Management --------------------------------------------
# The bot authenticates to Infisical using a Machine Identity via Universal Auth.
# All runtime secrets are fetched from Infisical at startup and refreshed in the
# background. Infisical is mandatory; the bot will not start without these.
INFISICAL_CLIENT_ID=yo_ur-client-id-here
INFISICAL_PROJECT_ID=your-project-id-here
INFISICAL_CLIENT_SECRET=your-client-secret-here
INFISICAL_SITE_URL=https://us.infisical.com
INFISICAL_ENVIRONMENT=your-environment-here

# ---- Non-sensitive configuration ---------------------------------------------
# These values are NOT secrets and may stay in .env.

# Discord developer channel for error reports (numeric channel ID).
DEVELOPER_CHANNEL_ID=999

# Database connection details.
# POSTGRES_* are used by Docker Compose to bootstrap the `db` container.
# The bot reads its own credential as DB_PW from Infisical; it should match
# POSTGRES_PASSWORD so the app can authenticate to the database.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD="something-something-something"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres

# ---- FairGate provably-fair backend ------------------------------------------------
# Base URL of the FairGate API. The app API key itself is stored in Infisical.
FAIRGATE_BASE_URL=http://localhost:8080

# Comma-separated list of casino games to resolve through FairGate.
# Leave empty to keep all games local. Example: mines,roulette,dice
FAIRGATE_ENABLED_GAMES=

# Optional: FairGate admin key used by owner-only bot commands to register new
# FairGate apps. Stored in Infisical; leave unset if app management is manual.
# FAIRGATE_ADMIN_API_KEY=
